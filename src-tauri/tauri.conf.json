{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corpora",
  "version": "../package.json",
  "identifier": "org.exegia.corpora",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../../corpora-web/build/client"
  },
  "app": {
    "windows": [
      {
        "title": "Corpora",
        "width": 1280,
        "height": 800,
        "label": "main",
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
